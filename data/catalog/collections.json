":"GRF.23.GRT","firstMint":"2023-10-31T12:47:35.000Z","lastMint":"2023-10-31T19:01:23.000Z","works":673,"supplyCap":null,"minting":false,"pieces":673,"holders":378,"floorWei":"1708070000000000","coverTokenId":"1","staleSince":null},{"code":"OVS","slug":"oversimulated","title":"oversimulated","contract":"0x685ec110408cede874604f75ff9ccbd297ccde21","standard":"erc721","platform":"transient","platformUrl":null,"links":[],"section":"index","techniques":["glitch art"],"tools":[],"format":"one-of-one","wallText":"archive emotions before they fade","accession":"GRF.25.OVS","firstMint":"2025-04-17T20:56:11.000Z","lastMint":"2026-05-22T01:08:59.000Z","works":24,"supplyCap":null,"minting":false,"pieces":24,"holders":15,"floorWei":null,"coverTokenId":"1","staleSince":null},{"code":"366","slug":"worthless","title":"WORTHLESS","contract":"0x33fd426905f149f8376e227d0c9d3340aad17af1","standard":"erc1155","platform":"6529","platformUrl":null,"links":[],"section":"index","techniques":["glitch art"],"tools":[],"format":"editions","wallText":"The Memes Collection is focused on the fight for the open metaverse (decentralization, community, self-sovereignty) and spreading this message to many people, many wallets.\n\nIt is a collection that is meant to be open and accessible. Edition sizes will generally be large and inexpensive, to spread the word and to avoid gas wars.\n\nWe will try to have a good time along the way, make some fun art, do great collabs and just generally have a good time.\n\nFor more information visit https://6529.io/about/the-memes","accession":"GRF.25.366","firstMint":"2025-05-26T09:22:23.000Z","lastMint":"2025-05-26T09:22:23.000Z","works":1,"supplyCap":null,"minting":false,"pieces":310,"holders":179,"floorWei":"63699999999999000","coverTokenId":"366","staleSince":null},{"code":"SUB","slug":"subsimulated","title":"subsimulated","contract":"0x5b5a4bcaedf305a6c85f83486a907a188224efa8","standard":"erc1155","platform":"transient","platformUrl":null,"links":[],"section":"index","techniques":["glitch art"],"tools":[],"format":"editions","wallText":"brother of https://opensea.io/collection/oversimulated","accession":"GRF.25.SUB","firstMint":"2025-06-13T13:45:35.000Z","lastMint":"2026-05-19T21:20:47.000Z","works":8,"supplyCap":null,"minting":false,"pieces":84,"holders":33,"floorWei":null,"coverTokenId":"1","staleSince":null},{"code":"PHG","slug":"phigures","title":"Phigures","contract":"0xcbbca0a0871a4f2a5567940c38a5c7fd6fbb6480","standard":"erc721","platform":"onchain","platformUrl":null,"links":[],"section":"index","techniques":["generative art","code art"],"tools":["mathematics","on-chain"],"format":"one-of-one","wallText":"On-chain generative anatomy. The wallet that mints a Phigure leaves a permanent imprint on its body. Its surface (palette, fill, background) re-stamps with every new owner. Algorithm and render engine stored on Ethereum, not IPFS. by gruff\n\nphigures.art","accession":"GRF.26.PHG","firstMint":"2026-05-14T17:32:47.000Z","lastMint":"2026-05-15T16:06:23.000Z","works":469,"supplyCap":null,"minting":false,"pieces":469,"holders":259,"floorWei":"661700000000000","coverTokenId":"1","staleSince":null},{"code":"FCT","slug":"facets","title":"FACETS","contract":"0xa219558e037063879315d6c0dc37aa29e1ed9f07","standard":"erc721","platform":"onchain","platformUrl":"https://thefacets.art","links":[{"label":"site","url":"https://thefacets.art"},{"label":"x","url":"https://x.com/facetsart"},{"label":"thread","url":"https://x.com/facetsart/status/2097902091637256575"}],"section":"index","techniques":["generative art","code art"],"tools":["mathematics","pixel grid","on-chain"],"format":"one-of-one","wallText":"FACETS is an art collection of 2,222 pieces built on seven distinct personas from the web3 space, each with its own story and characteristics. Fully on-chain and animated, drawn in Solidity as pixel blocks on a 35x35 grid.\n\nIt carries two mechanics: Burn to Forge, and The Turn, which shares royalties with holders. Every piece also turns toward the wallet holding it and is redrawn when it changes hands, and each one carries a name from a book of 832, written by hand.","accession":"GRF.26.FCT","firstMint":"2026-09-16T13:01:11.000Z","lastMint":"2026-09-30T01:47:11.000Z","works":2222,"supplyCap":null,"minting":false,"pieces":2222,"holders":261,"floorWei":"922910000000000","coverTokenId":"1","staleSince":null},{"code":"OVN","slug":"ovvn","title":"OVVN","contract":"0x11dd77cfda1ffa289522f028977fbfc0fc0fce67","standard":"erc721","platform":"onchain","platformUrl":null,"links":[{"label":"site","url":"https://ovvn.art"}],"section":"experiments","techniques":["generative art","code art"],"tools":["on-chain"],"format":"one-of-one","wallText":"Be your OVVN. A head from your camera or from the mint's own dice, drawn on-chain.","accession":"GRF.26.OVN","firstMint":"2026-09-27T20:16:11.000Z","lastMint":"2026-09-28T19:29:59.000Z","works":401,"supplyCap":null,"minting":false,"pieces":401,"holders":104,"floorWei":"1000000000000000","coverTokenId":"1","staleSince":null},{"code":"LSO","slug":"last-selfie-or","title":"Last Selfie or?","contract":"0x3ad11c41438ec881751b931c798ef201eea81ee6","standard":"erc721","platform":"foundation","platformUrl":null,"links":[],"section":"index","techniques":["vector illustration"],"tools":["photoshop"],"format":"editions","wallText":null,"accession":"GRF.23.LSO","firstMint":"2023-09-07T23:48:47.000Z","lastMint":"2023-10-23T08:56:59.000Z","works":10,"supplyCap":null,"minting":false,"pieces":10,"holders":9,"floorWei":null,"coverTokenId":"1","staleSince":null},{"code":"RES","slug":"resonance","title":"RESONANCE","contract":"0x346410e2c65400b448909c45a3c234e00eafdaa2","standard":"erc721","platform":"foundation","platformUrl":null,"links":[],"section":"index","techniques":["vector illustration"],"tools":["photoshop"],"format":"one-of-one","wallText":null,"accession":"GRF.24.RES","firstMint":"2024-01-28T17:02:47.000Z","lastMint":"2024-01-28T17:02:47.000Z","works":1,"supplyCap"