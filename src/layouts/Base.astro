---
import '@fontsource/castoro/400.css';
import '@fontsource/dm-mono/300.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import NoteBox from '../components/NoteBox.astro';
import Header, { type NavName } from '../components/Header.astro';
/** `image`: a site path for the link preview (a work's still, a collection's cover); the default card otherwise. */
interface Props { title: string; description?: string; current?: NavName; image?: string | null }
const { title, description = 'gruff — archive emotions before they fade.', current, image } = Astro.props;
const site = Astro.site ?? new URL('https://gruffarchive.art');
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? '/social-card.png', site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- link previews on X, Telegram, iMessage: the work itself, or the wordmark card -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gruff archive" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#000000" />
    <!-- the wordmark's own Castoro "g", centred on black (drawn once from the font into public/) -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <slot name="head" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="ink" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" result="d" />
        <feGaussianBlur in="d" stdDeviation="0.45" result="b" />
        <feComponentTransfer in="b"><feFuncA type="table" tableValues="0 0 0.6 1 1" /></feComponentTransfer>
      </filter>
    </svg>
    <Header current={current} />
    <main><slot /></main>
    <slot name="footer" />
    <NoteBox />
    <script src="../scripts/idle.ts"></script>
    <script src="../scripts/ago.ts"></script>
  </body>
</html>
