---
import type { CollectionOut, TokenOut } from '../lib/data';
import { displayName, formatDate, formatEth, formatUsd, mintValue, shortAddress } from '../lib/format';
import { etherscanAddress, etherscanToken, etherscanTx, openseaItem, platformLinkUnlessListed } from '../lib/links';
import { editionText, mintingText, sortOwners } from '../lib/label';
import { soldLabel } from '../lib/live-price';
import { ethParts } from '../lib/price-parts';
import { isEditions } from '../../indexer/tags';
interface Props { c: CollectionOut; t: TokenOut; ethUsd: number | null; asOf: string }
const { c, t, ethUsd, asOf } = Astro.props;
const year = (t.mint?.at ?? c.firstMint ?? '').slice(0, 4);
const platform = platformLinkUnlessListed(c, t.id);
const edition = editionText(t, c);
const collabs = t.collaborators ?? [];
const mintText = t.mint ? mintValue(t.mint) : '—';
// The keepers list matches its count: the artist's own copies and excluded holders are not keepers.
const owners = sortOwners(t.owners.filter((o) => !o.notKeeper));
const soleOwner = owners[0] ?? t.owners[0];
const snapshot = t.listing?.priceWei ?? '';
// not listed but sold before: the last sale takes the price spot, muted and labelled (the artist, 2026-11-07)
const sold = !t.listing && t.lastSale ? t.lastSale : null;
const bigText = t.listing ? formatEth(t.listing.priceWei) ?? '' : sold ? formatEth(sold.priceWei) ?? '' : 'not listed';
const big = ethParts(bigText);
// the dollar value of the eth shown, at today's rate, beside a listing and beside a last sale alike (the artist, 2026-11-07)
const usdText = t.listing ? formatUsd(t.listing.priceWei, ethUsd) : sold ? formatUsd(sold.priceWei, ethUsd) : null;
// the latest auction's bid war, winner on top (the artist, 2026-11-07)
const auction = t.auctions?.find((a) => a.bids.length > 0);
const houseName = (h: string) => (h === 'transient' ? 'transient' : h === 'foundation' ? 'foundation' : h);
---
<div class="label">
  <div class="f">{t.accession}</div>
  <h1 class="title lower">{t.name}</h1>
  <div class="k"><span class="lower">gruff</span>{collabs.length > 0 && <> × <span class="collab">{collabs.join(' · ')}</span></>}, {year}</div>
  <hr />
  {t.supply > 0 && (<>
  <div class="k" id="price-label">{t.listing ? 'listed' : sold ? soldLabel(formatDate(sold.at)) : ''}</div>
  <div class="pricerow">
    <div class:list={['price', { none: !t.listing && !sold, sold: !!sold }]} id="live-price" data-contract={t.supply > 0 ? c.contract : undefined} data-id={t.id} data-snapshot={snapshot} data-sold={t.lastSale?.priceWei ?? ''} data-sold-at={t.lastSale ? formatDate(t.lastSale.at) : ''}>
      {big ? <><span class="num">{big.num}</span><span class="cur">{big.cur}</span></> : bigText}
    </div>
    {/* the dollar value, quiet beside the eth (the artist, 2026-11-07); the live price script keeps it in step */}
    <span class="usd" id="live-usd" data-rate={ethUsd ?? ''}>{usdText ?? ''}</span>
  </div>
  <div class="f lower" id="price-note">{t.listing ? `as of ${formatDate(asOf)}` : <a class="offer hit" href={openseaItem(c.contract, t.id)} rel="noopener" target="_blank">make offer ↗</a>}</div>
  </>)}
  {t.mint && <div class="lr"><span class="l">{t.mint.primary ? 'primary' : 'mint'} {formatDate(t.mint.at)}</span><span class="v">{mintText}</span></div>}
  <div class="lr ls"><span class="l">last sale</span><span class="v">{t.lastSale ? `${formatEth(t.lastSale.priceWei)} · ${formatDate(t.lastSale.at)}` : 'none'}</span></div>
  {auction && (
    <details class="bids">
      <summary class="lr hit"><span class="l">bids · {houseName(auction.house)}</span><span class="v">{auction.bids.length} <span class="caret" aria-hidden="true">▾</span></span></summary>
      <ul class:list={['klist', { long: auction.bids.length > 30 }]}>
        {auction.bids.map((b, i) => (
          <li class="lr"><a class="l hit lower" href={etherscanTx(b.txHash)} target="_blank" rel="noopener">{displayName(b.bidder, b.ens)}{i === 0 && <span class="won"> · won</span>}</a><span class="v">{formatEth(b.priceWei)} <span class="when">{formatDate(b.at)}</span></span></li>
        ))}
      </ul>
    </details>
  )}
  {isEditions(c) && c.floorWei && <div class="lr"><span class="l">floor</span><span class="v">{formatEth(c.floorWei)}</span></div>}
  {c.standard === 'erc1155' && owners.length > 1 ? (
    <details class="keepers">
      <summary class="lr hit"><span class="l">keepers</span><span class="v">{t.holderCount} <span class="caret" aria-hidden="true">▾</span></span></summary>
      <ul class:list={['klist', { long: owners.length > 30 }]}>
        {owners.map((o) => (
          <li class="lr"><a class="l hit lower" href={etherscanAddress(o.address)} target="_blank" rel="noopener">{displayName(o.address, o.ens)}{o.escrow ? ' (on foundation)' : ''}</a><span class="v">{o.quantity}</span></li>
        ))}
      </ul>
    </details>
  ) : (
    soleOwner && <div class="lr"><span class="l">owner</span><span class="v">{displayName(soleOwner.address, soleOwner.ens)}{soleOwner.escrow ? ' (on foundation)' : ''}</span></div>
  )}
  <div class="lr"><span class="l">edition</span><span class="v">{edition}{mintingText(c) && <> · <span class="lower mnote">still minting</span></>}</span></div>
  <div class="lr"><span class="l">contract</span><button class="v copy" type="button" data-copy={c.contract}>{shortAddress(c.contract)} #{t.id}</button></div>
  {t.description && (<><hr /><p class="desc lower">{t.description}</p></>)}
  <p class="links">
    <a class="hit" href={etherscanToken(c.contract, t.id)} rel="noopener" target="_blank">etherscan ↗</a>
    <a class="hit" href={openseaItem(c.contract, t.id)} rel="noopener" target="_blank">opensea ↗</a>
    {platform && <a class="hit" href={platform.url} rel="noopener" target="_blank">{platform.label} ↗</a>}
    {(c.links ?? []).map((l) => <a class="hit" href={l.url} rel="noopener" target="_blank">{l.label} ↗</a>)}
  </p>
  <button class="print" type="button" id="print-label">print label ↓</button>
</div>
<style>
  .title { font: 400 15px/1.3 var(--mono); margin: 6px 0 4px; overflow-wrap: anywhere; }
  .keepers summary, .bids summary { cursor: pointer; list-style: none; display: flex; width: 100%; }
  .keepers summary::-webkit-details-marker, .bids summary::-webkit-details-marker { display: none; }
  .keepers[open] .caret, .bids[open] .caret { display: inline-block; transform: rotate(180deg); }
  .won, .when { color: var(--muted); }
  .pricerow { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 12px; }
  .usd { color: var(--muted); font-size: 14px; letter-spacing: 0; }
  .usd:empty { display: none; }
  .price.sold { color: var(--muted); }
  /* the last sale already stands in the price spot: its row below would only repeat it */
  .label:has(.price.sold) .ls { display: none; }
  .klist { list-style: none; margin: 0 0 6px; padding: 0 0 0 12px; }
  .klist.long { max-height: 320px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: #333 transparent; }
  .klist :global(li.lr) { padding: 0; }
  .klist a { text-decoration: none; min-width: 0; overflow-wrap: anywhere; }
  .mnote { color: var(--muted); }
  .collab { color: var(--fg, #fff); text-transform: none; }
  .desc { color: #aaa; line-height: 1.7; white-space: pre-line; overflow-wrap: anywhere; }
  .links { display: flex; gap: 14px; flex-wrap: wrap; margin: 14px 0; }
  .links a { text-decoration: underline; text-decoration-color: #444; text-underline-offset: 6px; }
  .copy { background: none; border: 0; color: inherit; font: inherit; cursor: copy; padding: 0; min-height: 44px; text-transform: none; }
  .print { background: none; border: 1px solid #444; color: #ddd; font: inherit; text-transform: uppercase; padding: 8px 12px; cursor: pointer; min-height: 44px; }
  .price.none { font-size: inherit; font-weight: 400; letter-spacing: normal; line-height: 1.5; color: var(--muted); text-transform: none; margin: 6px 0; }
  #price-note { margin-bottom: 10px; }
  .label :global(.lr) { align-items: center; }
  #price-note :global(a) { text-decoration: underline; text-decoration-color: #444; text-underline-offset: 6px; }
  .label :global(.lr .v) { min-width: 0; overflow-wrap: anywhere; }
</style>
