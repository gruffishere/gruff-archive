---
import sharp from 'sharp';
import type { Note } from '../lib/technique-notes';
interface Props { notes: Note[]; excerpt: string }
const { notes, excerpt } = Astro.props;
const size = async (src: string) => {
  const m = await sharp(`public${src}`).metadata();
  return { width: m.width ?? 0, height: m.height ?? 0 };
};
const withSize = await Promise.all(notes.map(async (n) => ({ ...n, sized: await Promise.all(n.images.map(async (i) => ({ ...i, ...(await size(i.src)) }))) })));
---
<div class="notes">
  {withSize.map((n) => (
    <article class="note" data-key={n.key}>
      <p class="k label">{n.label}</p>
      <div class="body">
        <p class="text lower">{n.text}</p>
        {n.sized.length > 0 && (
          <div class="imgs">
            {n.sized.map((i) => (
              <figure>
                <img src={i.src} alt={i.alt} width={i.width} height={i.height} loading="lazy" decoding="async" />
                {i.caption && <figcaption class="k">{i.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
        {n.excerpt && <pre class="code" tabindex="0"><code>{excerpt}</code></pre>}
        {n.links.length > 0 && <p class="links">{n.links.map((l) => <a class="hit" href={l.href}>→ {l.label}</a>)}</p>}
      </div>
    </article>
  ))}
</div>
<style>
  .notes { border-top: 1px solid var(--line); }
  .note { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 0 24px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .label { margin: 0; }
  .body { min-width: 0; }
  .text { margin: 0; max-width: 64ch; line-height: 1.6; }
  .imgs { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 16px; }
  .imgs figure { margin: 0; flex: 0 1 360px; min-width: 0; max-width: 360px; }
  .imgs img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .imgs figcaption { margin-top: 6px; font-size: 11px; }
  .code { margin: 16px 0 0; padding: 12px 14px; border: 1px solid var(--line); overflow-x: auto; max-width: 100%; font-size: 11px; line-height: 1.5; color: var(--muted); text-transform: none; letter-spacing: 0; }
  .links { margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 0 22px; }
  .links a { color: var(--muted); }
  @media (max-width: 767px) {
    .note { grid-template-columns: minmax(0, 1fr); gap: 8px 0; }
    .imgs figure { flex: 1 1 100%; max-width: none; }
    /* several images sit two to a row on a phone, so a note never turns into a long scroll of full-width pictures */
    .imgs:has(figure + figure) figure { flex: 0 1 calc(50% - 7px); max-width: calc(50% - 7px); }
  }
</style>
