---
import { TECHNIQUES } from '../../indexer/tags';
import type { Note } from '../lib/technique-notes';
interface Props { notes: Note[]; excerpt: string }
const { notes, excerpt } = Astro.props;

// The artist's pick (2026-11-06): the methods sit behind the lane they fed, one section per lane, in lane order.
const sections = TECHNIQUES.map((lane) => {
  const methods = notes.filter((n) => n.lane === lane);
  return { lane, methods, tools: methods.map((m) => m.label).filter((l) => l !== lane), images: methods.flatMap((m) => m.images), code: methods.some((m) => m.excerpt) };
}).filter((s) => s.methods.length > 0);
const apart = notes.filter((n) => n.lane === null);
---
<div class="behind-all">
  {sections.map((s) => (
    <section class="behind" data-lane={s.lane}>
      <p class="k bh"><span class="ln">{s.lane}</span>{s.tools.length > 0 && <span class="tools">{s.tools.join(' · ')}</span>}</p>
      <div class="cols">
        <div class="methods">
          {s.methods.map((m) => (
            <div class="method" data-key={m.key}>
              <p class="k ml">{m.label}{m.years && <span class="f"> · {m.years}</span>}</p>
              <p class="tx lower">{m.text}</p>
              {m.links.length > 0 && <p class="links">{m.links.map((l) => <a class="hit" href={l.href}>→ {l.label}</a>)}</p>}
            </div>
          ))}
        </div>
        <div class="strip">
          {s.images.map((i) => (
            <figure>
              <a class:list={['sq', { contain: i.fit === 'contain' }]} href={i.src} target="_blank" rel="noopener" aria-label={`${i.alt}, full size`}>
                <img src={i.src} alt={i.alt} width="600" height="600" loading="lazy" decoding="async" />
              </a>
              <figcaption class="k">{i.caption ?? i.alt}</figcaption>
            </figure>
          ))}
          {s.code && (
            <figure>
              <div class="sq codesq"><pre class="code" tabindex="0"><code>{excerpt}</code></pre></div>
              <figcaption class="k">facets #1, its own svg</figcaption>
            </figure>
          )}
        </div>
      </div>
    </section>
  ))}
  {apart.map((m) => <p class="ai" data-key={m.key}><span class="k">{m.label}</span><span class="tx lower">{m.text}</span></p>)}
</div>
<style>
  .behind { padding: 24px 0 34px; border-top: 1px solid var(--line); }
  .bh { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; margin: 0 0 20px; }
  .ln { color: var(--fg); }
  .tools { color: var(--muted); }
  .cols { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 0 48px; align-items: start; }
  .methods { display: grid; gap: 22px; }
  .ml { margin: 0 0 8px; }
  .tx { margin: 0; line-height: 1.65; max-width: 62ch; }
  .links { margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 0 22px; }
  .links a { color: var(--muted); }
  .strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 200px)); gap: 16px 14px; }
  .strip figure { margin: 0; min-width: 0; }
  .sq { display: block; aspect-ratio: 1; overflow: hidden; background: #0a0a0a; border: 1px solid var(--line); }
  .sq img { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity .3s ease; }
  .sq.contain img { object-fit: contain; }
  a.sq:hover img, a.sq:focus-visible img { opacity: .82; }
  a.sq:focus-visible { outline: 1px solid var(--fg); outline-offset: 2px; }
  .codesq { padding: 10px; }
  .code { margin: 0; height: 100%; overflow: auto; font-size: 10px; line-height: 1.55; color: var(--muted); text-transform: none; letter-spacing: 0; white-space: pre; }
  .strip figcaption { margin-top: 7px; font-size: 10px; color: var(--muted); }
  .ai { display: flex; gap: 18px; align-items: baseline; margin: 0; padding: 24px 0; border-top: 1px solid var(--line); }
  .ai .tx { max-width: 70ch; }
  @media (max-width: 899px) {
    .cols { grid-template-columns: minmax(0, 1fr); gap: 22px 0; }
    .strip { grid-template-columns: repeat(2, minmax(0, 1fr)); order: -1; }
  }
  @media (prefers-reduced-motion: reduce) { .sq img { transition: none; } }
</style>
