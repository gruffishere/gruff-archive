---
import { TECHNIQUES } from '../../indexer/tags';
import type { Technique } from '../../indexer/tags';
import { LINE_DASH } from '../lib/technique-notes';
import { PLOT_SPAN as SPAN, PLOT_TOP as TOP, smoothPath, yOf } from '../lib/chart-path';
interface Props { quarters: string[]; shares: Record<Technique, (number | null)[]> }
const { quarters, shares } = Astro.props;
const yearTicks = (qs: string[]) => qs.flatMap((q, i) => (i === 0 || q.slice(0, 4) !== (qs[i - 1] ?? "").slice(0, 4) ? [{ i, year: q.slice(0, 4) }] : []));
const n = quarters.length || 1;
const label = quarters.length
  ? `how gruff leaned on each technique, one vote per collection, from ${quarters[0]} to ${quarters.at(-1)}; the table below holds the values`
  : 'how gruff leaned on each technique; no dated works yet';
---
<figure class="tchart" style={`--n:${n}`}>
  <ul class="legend">{TECHNIQUES.map((t) => <li><svg width="34" height="8" aria-hidden="true"><line x1="1" y1="4" x2="33" y2="4" stroke="currentColor" stroke-width="2" stroke-dasharray={LINE_DASH[t] || undefined} /></svg>{t}</li>)}</ul>
  <div class="grid">
    <span class="k y" style={`top:${TOP}%`}>100%</span><span class="k y" style={`top:${TOP + SPAN / 2}%`}>50%</span><span class="k y" style={`top:${TOP + SPAN}%`}>0%</span>
    <svg class="plot" viewBox={`0 0 ${n} 100`} preserveAspectRatio="none" role="img" aria-label={label}>
      {[0, 50, 100].map((v) => <line x1="0" x2={n} y1={yOf(v, 1.5)} y2={yOf(v, 1.5)} class="gl" vector-effect="non-scaling-stroke" />)}
      {TECHNIQUES.map((t, k) => <path d={smoothPath(shares[t] ?? [], k)} class="ln" stroke-dasharray={LINE_DASH[t] || undefined} vector-effect="non-scaling-stroke" />)}
    </svg>
  </div>
  <div class="years">{yearTicks(quarters).map(({ i, year }) => <span class="k" style={`left:calc(${(i + 0.5) / n} * 100%)`}>{year}</span>)}</div>
  <div class="sr"><table>
    <caption>technique share by quarter, one vote per collection</caption>
    <thead><tr><th>quarter</th>{TECHNIQUES.map((t) => <th>{t}</th>)}</tr></thead>
    <tbody>{quarters.map((q, i) => <tr><th>{q}</th>{TECHNIQUES.map((t) => <td>{shares[t]?.[i] == null ? 'no works' : `${shares[t][i]}%`}</td>)}</tr>)}</tbody>
  </table></div>
</figure>
<style>
  .tchart { margin: 0; --axis: 56px; }
  .legend { list-style: none; margin: 0 0 22px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 26px; }
  .legend li { display: inline-flex; align-items: center; gap: 10px; }
  .grid { position: relative; padding-left: var(--axis); }
  .plot { width: 100%; height: 300px; display: block; overflow: visible; }
  .y { position: absolute; left: 0; width: calc(var(--axis) - 12px); text-align: right; font-size: 11px; line-height: 1; transform: translateY(-50%); }
  .years { position: relative; height: 22px; margin: 10px 0 0 var(--axis); }
  .years span { position: absolute; top: 0; transform: translateX(-50%); font-size: 11px; }
  .ln { fill: none; stroke: var(--fg); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .gl { stroke: var(--line); stroke-width: 1; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 767px) {
    .tchart { --axis: 40px; }
    .plot { height: 220px; }
    .legend { gap: 8px 18px; }
  }
</style>
