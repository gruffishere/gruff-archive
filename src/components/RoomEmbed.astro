---
// Click-to-load: the poster (the room's cover) and one `enter ↗` button. Only the click creates the iframe,
// so a 3D scene or an app never loads on a page visit. The iframe is built in src/scripts/room-embed.ts.
// Used by the room pages and by the Pulverulents trailer block on its collection page.
interface Props { src: string; title: string; cover?: string | null; label?: string }
const { src, title, cover = null, label = 'enter ↗' } = Astro.props;
---
<div class="embed" data-embed data-src={src} data-title={title}>
  <button class="poster" type="button">
    {cover && <img src={cover} alt="" decoding="async" />}
    <span class="enter">{label}</span>
  </button>
  <noscript><a class="hit" href={src} target="_blank" rel="noopener">{label}</a></noscript>
</div>
<style>
  .embed { margin: 26px 0 0; max-width: 1100px; }
  .poster { position: relative; display: block; width: 100%; padding: 0; border: 0; background: #050505; color: inherit; font: inherit; text-transform: inherit; cursor: pointer; aspect-ratio: 16 / 10; overflow: hidden; }
  .poster img { width: 100%; height: 100%; object-fit: cover; opacity: .72; transition: opacity .6s ease; }
  .poster:hover img, .poster:focus-visible img { opacity: 1; }
  .poster:focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
  .enter { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; background: #000; color: var(--fg); border: 1px solid var(--dot); }
  .poster:hover .enter, .poster:focus-visible .enter { background: var(--fg); color: #000; }
  .embed :global(.frame) { width: 100%; aspect-ratio: 16 / 10; max-height: 86vh; border: 0; background: #050505; }
  @media (max-width: 767px) {
    .poster, .embed :global(.frame) { aspect-ratio: 4 / 5; max-height: none; }
  }
  @media (prefers-reduced-motion: reduce) { .poster img { transition: none; } }
</style>
<script src="../scripts/room-embed.ts"></script>
