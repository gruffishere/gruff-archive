---
// A work whose live page lives in its contract: the stored still, and `play ▶` that reads tokenURI from a public RPC
// in the visitor's browser and runs the page in a sandboxed iframe in the still's place (src/scripts/live-work.ts).
// The archive keeps no copy of the live page, so what plays is always what the contract serves now.
import MediaView from './MediaView.astro';
import type { TokenOut } from '../lib/data';
interface Props { token: TokenOut; contract: string; alt: string }
const { token, contract, alt } = Astro.props;
---
<div class="live" data-live data-contract={contract} data-id={token.id} data-title={alt}>
  <div class="screen"><MediaView token={token} size="large" alt={alt} eager /></div>
  <p class="bar"><button class="play" type="button">play ▶</button> <span class="note f" role="status" aria-live="polite">live from the chain, with sound</span></p>
</div>
<style>
  .screen { position: relative; }
  .screen :global(iframe.livef) { display: block; width: 100%; border: 0; background: #000; }
  .bar { display: flex; align-items: center; gap: 12px; margin: 10px 0 0; flex-wrap: wrap; }
  .play { min-height: 44px; padding: 0 18px; background: #000; color: var(--fg); border: 1px solid var(--dot); font: inherit; cursor: pointer; }
  .play:hover, .play:focus-visible { background: var(--fg); color: #000; }
  .play[disabled] { opacity: .6; cursor: progress; }
</style>
<script src="../scripts/live-work.ts"></script>
