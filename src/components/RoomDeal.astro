---
// The Playing Cards deal. The renderer is the project's own (public/exp/playing-cards/gen.js in a worker, player.js on
// canvas); nothing loads until `deal` is pressed. Scripted in src/scripts/room-deal.ts.
import type { Room } from '../lib/rooms';
import { DEALT_DECKS, SUITS, rankLabel } from '../lib/deal';
import samples from '../lib/sample-cards.json';
interface Props { room: Room; gallery?: boolean }
const { room, gallery = false } = Astro.props;
const nameOf = (key: string) => DEALT_DECKS.find((d) => d.key === key)?.name ?? key;
const glyphOf = (suit: string) => SUITS.find((s) => s.key === suit)?.glyph ?? '';
---
<div class="deal" data-deal>
  <div class="table" data-table>
    <button class="poster" type="button" data-deal-btn>
      <img src={room.cover} alt="" decoding="async" />
      <span class="enter">deal</span>
    </button>
  </div>
  <p class="k status" data-status aria-live="polite"></p>
  <noscript><p class="k">cards are drawn live in the browser; this room needs scripts.</p></noscript>
  {gallery && (
    <ul class="cards" aria-label="sample cards">
      {samples.map((c) => (
        <li>
          <img src={`/exp/${room.slug}/cards/${c.deck}-${c.suit}-${c.rank}.webp`} alt="" loading="lazy" decoding="async" width="600" height="840" />
          <span class="k">{rankLabel(c.rank)} {glyphOf(c.suit)} · {nameOf(c.deck)}</span>
        </li>
      ))}
    </ul>
  )}
</div>
<style>
  .deal { margin: 26px 0 0; max-width: 1240px; }
  .table { background: #0a0a0a; padding: clamp(14px, 3vw, 36px); }
  .poster { display: flex; flex-direction: column; align-items: center; gap: 14px; width: 100%; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; text-transform: inherit; cursor: pointer; }
  .poster img { width: 100%; height: clamp(220px, 32vw, 340px); object-fit: contain; opacity: .72; transition: opacity .6s ease; }
  .poster:hover img, .poster:focus-visible img { opacity: 1; }
  .poster:focus-visible { outline: 1px solid var(--fg); outline-offset: 3px; }
  .enter { display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px; background: #000; color: var(--fg); border: 1px solid var(--dot); }
  .poster:hover .enter, .poster:focus-visible .enter { background: var(--fg); color: #000; }
  .status { margin: 10px 0 0; min-height: 18px; }
  .cards { list-style: none; margin: 44px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 14px; }
  @media (min-width: 560px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .cards { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px 20px; } }
  .cards li { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .cards img { width: 100%; height: auto; aspect-ratio: 5 / 7; background: #0a0a0a; border-radius: 10px; }
  /* everything below is created at runtime */
  .table :global(.hand) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 14px; justify-items: stretch; }
  @media (min-width: 480px) { .table :global(.hand) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .table :global(.hand) { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 22px 20px; } }
  .table :global(.hand figure) { margin: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .table :global(.hand .slot) { position: relative; aspect-ratio: 1000 / 1400; background: #0f0f0f; border-radius: 10px; }
  .table :global(.hand canvas) { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  .table :global(.hand figcaption) { font-size: 11px; line-height: 1.4; color: var(--dim); }
  .table :global(.again) { display: inline-flex; align-items: center; min-height: 44px; margin-top: 14px; padding: 0 4px; background: none; border: 0; color: var(--fg); font: inherit; text-transform: inherit; cursor: pointer; text-decoration: underline; text-decoration-color: #444; text-underline-offset: 6px; }
  .table :global(.again[aria-disabled='true']) { color: var(--faint); cursor: default; }
  .table :global(.hand .slot.failed) { display: flex; align-items: center; justify-content: center; padding: 8px; font-size: 10px; text-align: center; color: var(--faint); }
  @media (prefers-reduced-motion: reduce) { .poster img { transition: none; } }
</style>
<script src="../scripts/room-deal.ts"></script>
