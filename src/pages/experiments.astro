---
import Base from '../layouts/Base.astro';
import { collections, tokensOf } from '../lib/data';
import { experimentCollections, firstYear } from '../lib/collections';
import { chooseMedia } from '../lib/media';
import { collectionPath } from '../lib/links';
import { ROOMS, roomMeta, roomPath } from '../lib/rooms';
// the experiment collections, then the rooms, as one list of quiet cards
const collectionCards = experimentCollections(collections()).map((c) => {
  const t = tokensOf(c.slug).find((x) => x.id === c.coverTokenId) ?? tokensOf(c.slug)[0];
  const m = t ? chooseMedia(t, 'thumb') : null;
  return { href: collectionPath(c.slug), title: c.title, src: m?.src ?? null, pixelated: !!m?.pixelated, top: c.accession, status: `${firstYear(c)} · ${c.works} works` };
});
const roomCards = ROOMS.map((r) => ({ href: roomPath(r.slug), title: r.title, src: r.cover, pixelated: false, top: r.medium ?? null, status: roomMeta({ ...r, medium: undefined }).join(' · ') }));
const cards = [...collectionCards, ...roomCards];
---
<Base title="experiments — gruff" current="experiments">
  <section class="page">
    <p class="k intro">experiments · rooms where things are still moving</p>
    <div class="rooms">
      {cards.map((card) => (
        <a class="room" href={card.href}>
          {card.src ? <img src={card.src} alt="" loading="lazy" class:list={{ px: card.pixelated }} /> : <div class="empty" />}
          {card.top && <span class="k">{card.top}</span>}
          <span class="lead">{card.title}</span>
          <span class="k">{card.status}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .intro { margin: 26px 0 22px; }
  .rooms { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 28px; }
  .room { display: flex; flex-direction: column; gap: 4px; min-height: 44px; }
  .room img, .room .empty { aspect-ratio: 1 / 1; object-fit: cover; width: 100%; background: #0b0b0b; margin-bottom: 8px; }
  .px { image-rendering: pixelated; }
</style>
